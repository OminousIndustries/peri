# ─────────────────────────────────────────────────────────────────────────────
# Peri device environment  —  template
# Put your OpenAI API key on the OPENAI_API_KEY line below.
# It stays on the device (root:peri 0640 at /etc/peri/peri.env) and is NEVER sent
# to the browser. Set it with:  sudo peri-config set OPENAI_API_KEY sk-…
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

PERI_PORT=8420
PERI_BIND=127.0.0.1

# Head (neck) driver: auto | serial | gpio | sim | none
# Standard enclosure: the optional Arduino has separate power and no Pi connection.
PERI_HEAD_DRIVER=none
#PERI_HEAD_SERIAL_PORT=/dev/ttyUSB0
#PERI_HEAD_GPIO_PINS=5,6,13,26
#PERI_HEAD_INVERT=0
PERI_HEAD_MAX_SPEED_DPS=16
PERI_HEAD_ACCEL_DPS2=40
PERI_HEAD_HARD_LIMIT_DEG=25

PERI_LOG_LEVEL=info
