# Peri boot splash (Plymouth "script" module) - generated by scripts/setup-boot.sh from scripts/data/plymouth/peri.script.in.
# Near-black background (#0A0B0E) with the boot logo centred; the logo is scaled down when the screen is smaller than it.
# Rotation (PERI_OPT_SPLASH_ROTATE, clockwise): @PERI_SPLASH_ROTATE_DEG@ degrees.
Window.SetBackgroundTopColor(0.039, 0.043, 0.055);
Window.SetBackgroundBottomColor(0.039, 0.043, 0.055);

logo.image = Image("boot-logo.png");
if (logo.image) {
    angle = @PERI_SPLASH_ROTATE_RAD@;
    if (angle != 0) {
        logo.image = logo.image.Rotate(angle);
    }
    scale = Math.Min(Window.GetWidth() / logo.image.GetWidth(), Window.GetHeight() / logo.image.GetHeight());
    if (scale < 1) {
        logo.image = logo.image.Scale(Math.Int(logo.image.GetWidth() * scale), Math.Int(logo.image.GetHeight() * scale));
    }
    logo.sprite = Sprite(logo.image);
    logo.sprite.SetX(Window.GetX() + (Window.GetWidth() - logo.image.GetWidth()) / 2);
    logo.sprite.SetY(Window.GetY() + (Window.GetHeight() - logo.image.GetHeight()) / 2);
    logo.sprite.SetZ(10);
}
