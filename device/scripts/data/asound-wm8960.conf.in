# Managed by the Peri installer (asound.conf for the WM8960 audio HAT) - generated by scripts/setup-audio.sh.
# Safe to delete. The installer only rewrites /etc/asound.conf while it still starts with the line above, and never when
# the file is a symlink (vendor drivers such as seeed-voicecard / wm8960-soundcard re-link it at every boot).
#
# Pure-ALSA setup (no PipeWire/PulseAudio): the card is addressed by NAME (card numbers move when HDMI audio appears).
# dmix/dsnoop let the browser play and record at the same time.
pcm.!default {
    type asym
    playback.pcm "playback"
    capture.pcm "capture"
}
pcm.playback {
    type plug
    slave.pcm "dmixed"
}
pcm.capture {
    type plug
    slave.pcm "array"
}
pcm.dmixed {
    type dmix
    slave.pcm "hw:CARD=@PERI_CARD_ID@"
    ipc_key 555555
    ipc_perm 0666           # root's audio-test must not lock the peri user out of the shared device
}
pcm.array {
    type dsnoop
    slave {
        pcm "hw:CARD=@PERI_CARD_ID@"
        channels 2
    }
    ipc_key 666666
    ipc_perm 0666
}
ctl.!default {
    type hw
    card @PERI_CARD_ID@
}
